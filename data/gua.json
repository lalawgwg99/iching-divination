    "upper_trigram": "離",
    "lower_trigram": "艮",
    "guaci": "旅：小亨，旅貞吉。",
    "yao": [
      {
        "label": "初六",
        "text": "旅瑣瑣，斯其所取災。"
      },
      {
        "label": "六二",
        "text": "旅即次，懷其資，得僮僕貞。"
