    "name": "既濟",
    "upper_trigram": "坎",
    "lower_trigram": "離",
    "guaci": "既濟：亨小。利貞。初吉終亂。",
    "yao": [
      {
        "label": "初九",
        "text": "曳其輪，濡其尾，无咎。"
      },
      {
        "label": "六二",
        "text": "婦喪其茀，勿逐，七日得。"
      },
      {
        "label": "九三",
        "text": "高宗伐鬼方，三年克之，小人勿用。"
      },
      {
        "label": "六四",
        "text": "繻有衣袽，終日戒。"
      },
      {
        "label": "九五",
        "text": "東鄰殺牛，不如西鄰之禴祭，實受其福。"
      },
      {
        "label": "上六",
        "text": "濡其首，厲。"
      }
    ],
    "yong": null
  },
  {
    "n": 64,
    "name": "未濟",
    "upper_trigram": "離",
    "lower_trigram": "坎",
    "guaci": "未濟：亨。小狐汔濟，濡其尾，无攸利。",
    "yao": [
      {
        "label": "初六",
        "text": "濡其尾，吝。"
      },
      {
        "label": "九二",
        "text": "曳其輪，貞吉。"
      },
      {
        "label": "六三",
        "text": "未濟，征凶，利涉大川。"
      },
      {
        "label": "九四",
        "text": "貞吉，悔亡，震用伐鬼方，三年有賞于大國。"
      },
      {
        "label": "六五",
        "text": "貞吉，无悔，君子之光，有孚，吉。"
      },
      {
        "label": "上九",
        "text": "有孚于飲酒，无咎，濡其首，有孚失是。"
      }
    ],
    "yong": null
  }
]