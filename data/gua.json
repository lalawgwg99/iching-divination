      {
        "label": "六四",
        "text": "悔亡，田獲三品。"
      },
      {
        "label": "九五",
        "text": "貞吉悔亡，无不利。无初有終，先庚三日，後庚三日，吉。"
      },
      {
        "label": "上九",
        "text": "巽在牀下，喪其資斧，貞凶。"
      }
    ],
    "yong": null
  },
  {
    "n": 58,
    "name": "兌",
    "upper_trigram": "兌",
    "lower_trigram": "兌",
    "guaci": "兌：亨。利貞。",
    "yao": [
      {
        "label": "初九",
        "text": "和兌，吉。"
      },
      {
        "label": "九二",
        "text": "孚兌，吉，悔亡。"
      },
      {
        "label": "六三",
        "text": "來兌，凶。"
      },
      {
        "label": "九四",
        "text": "商兌，未寧，介疾有喜。"
      },
      {
        "label": "九五",
        "text": "孚于剝，有厲。"
      },
      {
        "label": "上六",
        "text": "引兌。"
      }
    ],
    "yong": null
  },
  {
    "n": 59,
    "name": "渙",
    "upper_trigram": "巽",
    "lower_trigram": "坎",
    "guaci": "渙：亨，王假有廟，利涉大川，利貞。",
    "yao": [
      {
        "label": "初六",
        "text": "用拯馬壯，吉，悔亡。"
      },
      {
        "label": "九二",
        "text": "渙奔其机，悔亡。"
      },
      {
        "label": "六三",
        "text": "渙其躬，无悔。"
      },
      {
        "label": "六四",
        "text": "渙其群，元吉。渙有丘，匪夷所思。"
      },
      {
        "label": "九五",
        "text": "渙汗其大號，渙王居，无咎。"
      },
      {
        "label": "上九",
        "text": "渙其血，去逖出，无咎。"
      }
    ],
    "yong": null
  },
  {
    "n": 60,
    "name": "節",
    "upper_trigram": "坎",
    "lower_trigram": "兌",
    "guaci": "節：亨。苦節不可貞。",
    "yao": [
      {
        "label": "初九",
        "text": "不出戶庭，无咎。"
      },
      {
        "label": "九二",
        "text": "不出門庭，凶。"
      },
      {
        "label": "六三",
        "text": "不節若，則嗟若，无咎。"
      },
      {
        "label": "六四",
        "text": "安節，亨。"
      },
      {
        "label": "九五",
        "text": "甘節，吉；往有尚。"
      },
      {
        "label": "上六",
        "text": "苦節，貞凶，悔亡。"
      }
    ],
    "yong": null
  },
  {
    "n": 61,
    "name": "中孚",
    "upper_trigram": "巽",
    "lower_trigram": "兌",
    "guaci": "中孚：豚魚吉，利涉大川，利貞。",
    "yao": [
      {
        "label": "初九",
        "text": "虞吉，有它不燕。"
      },
      {
        "label": "九二",
        "text": "鳴鶴在陰，其子和之，我有好爵，吾與爾靡之。"
      },
      {
        "label": "六三",
        "text": "得敵，或鼓或罷，或泣或歌。"
      },
      {
        "label": "六四",
        "text": "月既望，馬匹亡，无咎。"
      },
      {
        "label": "九五",
        "text": "有孚攣如，无咎。"
      },
      {
        "label": "上九",
        "text": "翰音登于天，貞凶。"
      }
    ],
    "yong": null
  },
  {
