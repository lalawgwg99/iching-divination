    "name": "歸妹",
    "upper_trigram": "震",
    "lower_trigram": "兌",
    "guaci": "歸妹：征凶，无攸利。",
    "yao": [
      {
        "label": "初九",
        "text": "歸妹以娣，跛能履，征吉。"
      },
      {
        "label": "九二",
        "text": "眇能視，利幽人之貞。"
      },
      {
        "label": "六三",
        "text": "歸妹以須，反歸以娣。"
