    "name": "豐",
    "upper_trigram": "震",
    "lower_trigram": "離",
    "guaci": "豐：亨。王假之，勿憂，宜日中。",
    "yao": [
      {
        "label": "初九",
        "text": "遇其配主，雖旬无咎，往有尚。"
      },
      {
        "label": "六二",
        "text": "豐其蔀，日中見斗，往得疑疾，有孚發若，吉。"
