[
  {
    "n": 1,
    "name": "乾",
    "upper_trigram": "乾",
    "lower_trigram": "乾",
    "guaci": "乾：元亨。利貞。",
    "yao": [
      {
        "label": "初九",
        "text": "潛龍勿用。"
      },
      {
        "label": "九二",
        "text": "見龍在田，利見大人。"
      },
      {
        "label": "九三",
        "text": "君子終日乾乾，夕惕若；厲，无咎。"
      },
      {
        "label": "九四",
        "text": "或躍在淵，无咎。"
      },
      {
        "label": "九五",
        "text": "飛龍在天，利見大人。"
      },
      {
        "label": "上九",
        "text": "亢龍，有悔。"
      }
    ],
    "yong": "用九：見羣龍无首，吉。"
  },
  {
    "n": 2,
    "name": "坤",
    "upper_trigram": "坤",
    "lower_trigram": "坤",
    "guaci": "坤：元亨。利牝馬之貞。君子有攸往，先迷後得主。利西南得朋，東北喪朋。安貞，吉。",
    "yao": [
      {
        "label": "初六",
        "text": "履霜，堅冰至。"
      },
      {
        "label": "六二",
        "text": "直方大，不習无不利。"
      },
      {
        "label": "六三",
        "text": "含章，可貞。或從王事，无成有終。"
      },
      {
        "label": "六四",
        "text": "括囊，无咎无譽。"
      },
      {
        "label": "六五",
        "text": "黃裳，元吉。"
      },
      {
        "label": "上六",
        "text": "龍戰于野，其血玄黃。"
      }
    ],
    "yong": "用六：利永貞。"
  },
  {
    "n": 3,
    "name": "屯",
    "upper_trigram": "坎",
    "lower_trigram": "震",
    "guaci": "屯：元亨，利貞。勿用有攸往，利建侯。",
    "yao": [
      {
        "label": "初九",
        "text": "磐桓，利居貞，利建侯。"
      },
      {
        "label": "六二",
        "text": "屯如邅如，乘馬班如，匪寇婚媾，女子貞不字，十年乃字。"
      },
      {
        "label": "六三",
        "text": "即鹿无虞，惟入于林中，君子幾不如舍，往吝。"
      },
      {
        "label": "六四",
        "text": "乘馬班如，求婚媾，往，吉无不利。"
      },
      {
        "label": "九五",
        "text": "屯其膏；小貞吉，大貞凶。"
      },
      {
        "label": "上六",
        "text": "乘馬班如，泣血漣如。"
      }
    ],
    "yong": null
  },
  {
    "n": 4,
    "name": "蒙",
    "upper_trigram": "艮",
    "lower_trigram": "坎",
    "guaci": "蒙：亨。匪我求童蒙，童蒙求我。初筮告，再三瀆，瀆則不告。利貞。",
    "yao": [
      {
        "label": "初六",
        "text": "發蒙，利用刑人，用說桎梏，以往吝。"
      },
      {
        "label": "九二",
        "text": "包蒙吉，納婦吉，子克家。"
      },
      {
        "label": "六三",
        "text": "勿用取女，見金夫，不有躬，无攸利。"
      },
      {
        "label": "六四",
        "text": "困蒙，吝。"
      },
      {
        "label": "六五",
        "text": "童蒙，吉。"
      },
      {
        "label": "上九",
        "text": "擊蒙，不利為寇，利禦寇。"
      }
    ],
    "yong": null
  },
  {
    "n": 5,
    "name": "需",
    "upper_trigram": "坎",
    "lower_trigram": "乾",
    "guaci": "需：有孚，光亨。貞吉，利涉大川。",
    "yao": [
      {
        "label": "初九",
        "text": "需于郊，利用恆，无咎。"
      },
      {
        "label": "九二",
        "text": "需于沙，小有言，終吉。"
      },
      {
        "label": "九三",
        "text": "需于泥，致寇至。"
      },
      {
        "label": "六四",
        "text": "需于血，出自穴。"
      },
      {
        "label": "九五",
        "text": "需于酒食，貞吉。"
      },
      {
        "label": "上六",
        "text": "入于穴，有不速之客三人來，敬之終吉。"
      }
    ],
    "yong": null
  },
  {
    "n": 6,
    "name": "訟",
    "upper_trigram": "乾",
    "lower_trigram": "坎",
    "guaci": "訟：有孚，窒，惕，中吉，終凶。利見大人，不利涉大川。",
    "yao": [
      {
        "label": "初六",
        "text": "不永所事，小有言，終吉。"
      },
      {
        "label": "九二",
        "text": "不克訟，歸而逋，其邑人三百戶无眚。"
      },
      {
        "label": "六三",
        "text": "食舊德，貞厲，終吉。或從王事，无成。"
      },
      {
        "label": "九四",
        "text": "不克訟，復即命渝，安貞吉。"
      },
      {
        "label": "九五",
        "text": "訟，元吉。"
      },
      {
        "label": "上九",
        "text": "或錫之鞶帶，終朝三褫之。"
      }
    ],
    "yong": null
  },
  {
    "n": 7,
    "name": "師",
    "upper_trigram": "坤",
    "lower_trigram": "坎",
    "guaci": "師：貞丈人吉，无咎。",
    "yao": [
      {
        "label": "初六",
        "text": "師出以律，否臧，凶。"
      },
      {
        "label": "九二",
        "text": "在師中吉，无咎；王三錫命。"
      },
      {
        "label": "六三",
        "text": "師或輿尸，凶。"
      },
      {
        "label": "六四",
        "text": "師左次，无咎。"
      },
      {
        "label": "六五",
        "text": "田有禽，利執言，无咎。長子帥師，弟子輿尸，貞凶。"
      },
      {
        "label": "上六",
        "text": "大君有命，開國承家，小人勿用。"
      }
    ],
    "yong": null
  },
  {
    "n": 8,
    "name": "比",
    "upper_trigram": "坎",
    "lower_trigram": "坤",
    "guaci": "比：吉。原筮元永貞，无咎。不寧方來，後夫凶。",
    "yao": [
      {
        "label": "初六",
        "text": "有孚，比之，无咎。有孚盈缶，終來有它，吉。"
      },
      {
        "label": "六二",
        "text": "比之自內，貞吉。"
      },
      {
        "label": "六三",
        "text": "比之匪人。"
      },
      {
        "label": "六四",
        "text": "外比之，貞吉。"
      },
      {
        "label": "九五",
        "text": "顯比。王用三敺，失前禽，邑人不誡，吉。"
      },
      {
        "label": "上六",
        "text": "比之无首，凶。"
      }
    ],
    "yong": null
  },
  {
    "n": 9,
    "name": "小畜",
    "upper_trigram": "巽",
    "lower_trigram": "乾",
    "guaci": "小畜：亨。密雲不雨，自我西郊。",
    "yao": [
      {
        "label": "初九",
        "text": "復自道，何其咎，吉。"
      },
      {
        "label": "九二",
        "text": "牽復，吉。"
      },
      {
        "label": "九三",
        "text": "車說輹，夫妻反目。"
      },
      {
        "label": "六四",
        "text": "有孚，血去惕出，无咎。"
      },
      {
        "label": "九五",
        "text": "有孚攣如，富以其鄰。"
      },
      {
        "label": "上九",
        "text": "既雨既處，尚得載，婦貞厲，月幾望，君子征凶。"
      }
    ],
    "yong": null
  },
  {
    "n": 10,
    "name": "履",
    "upper_trigram": "乾",
    "lower_trigram": "兌",
    "guaci": "履虎尾，不咥人，亨。",
    "yao": [
      {
        "label": "初九",
        "text": "素履，往无咎。"
      },
      {
        "label": "九二",
        "text": "履道坦坦，幽人貞吉。"
      },
      {
        "label": "六三",
        "text": "眇能視，跛能履，履虎尾，咥人，凶。武人為于大君。"
      },
      {
        "label": "九四",
        "text": "履虎尾，愬愬終吉。"
      },
      {
        "label": "九五",
        "text": "夬履，貞厲。"
      },
      {
        "label": "上九",
        "text": "視履考詳，其旋元吉。"
      }
    ],
    "yong": null
  },
  {
    "n": 11,
    "name": "泰",
    "upper_trigram": "坤",
    "lower_trigram": "乾",
    "guaci": "泰：小往大來，吉亨。",
    "yao": [
      {
        "label": "初九",
        "text": "拔茅茹以其彙，征吉。"
      },
      {
        "label": "九二",
        "text": "包荒。用馮河，不遐遺；朋亡。得尚于中行。"
      },
      {
        "label": "九三",
        "text": "无平不陂，无往不復，艱貞无咎。勿恤其孚，于食有福。"
      },
      {
        "label": "六四",
        "text": "翩翩，不富以其鄰；不戒以孚。"
      },
      {
        "label": "六五",
        "text": "帝乙歸妹，以祉，元吉。"
      },
      {
        "label": "上六",
        "text": "城復于隍，勿用師，自邑告命，貞吝。"
      }
    ],
    "yong": null
  },
  {
    "n": 12,
    "name": "否",
    "upper_trigram": "乾",
    "lower_trigram": "坤",
    "guaci": "否之匪人，不利君子貞，大往小來。",
    "yao": [
      {
        "label": "初六",
        "text": "拔茅茹以其彙，貞吉。亨。"
      },
      {
        "label": "六二",
        "text": "包承，小人吉，大人否。亨。"
      },
      {
        "label": "六三",
        "text": "包羞。"
      },
      {
        "label": "九四",
        "text": "有命，无咎，疇離祉。"
      },
      {
        "label": "九五",
        "text": "休否，大人吉。其亡其亡，繫于包桑。"
      },
      {
        "label": "上九",
        "text": "傾否，先否後喜。"
      }
    ],
    "yong": null
  },
  {
    "n": 13,
    "name": "同人",
    "upper_trigram": "乾",
    "lower_trigram": "離",
    "guaci": "同人于野，亨。利涉大川，利君子貞。",
    "yao": [
      {
        "label": "初九",
        "text": "同人于門，無咎。"
      },
      {
        "label": "六二",
        "text": "同人于宗，吝。"
      },
      {
        "label": "九三",
        "text": "伏戎于莽，升其高陵，三歲不興。"
      },
      {
        "label": "九四",
        "text": "乘其庸，弗克攻，吉。"
      },
      {
        "label": "九五",
        "text": "同人，先號啕而後笑。大師克相遇。"
      },
      {
        "label": "上九",
        "text": "同人于郊，無悔。"
      }
    ],
    "yong": null
  },
  {
    "n": 14,
    "name": "大有",
    "upper_trigram": "離",
    "lower_trigram": "乾",
    "guaci": "大有：元亨。",
    "yao": [
      {
        "label": "初九",
        "text": "无交害，匪咎，艱則无咎。"
      },
      {
        "label": "九二",
        "text": "大轝以載，有攸往，无咎。"
      },
      {
        "label": "九三",
        "text": "公用亨于天子，小人弗克。"
      },
      {
        "label": "九四",
        "text": "匪其尫，无咎。"
      },
      {
        "label": "六五",
        "text": "厥孚交如，威如；吉。"
      },
      {
        "label": "上九",
        "text": "自天佑之，吉无不利。"
      }
    ],
    "yong": null
  },
  {
    "n": 15,
    "name": "謙",
    "upper_trigram": "坤",
    "lower_trigram": "艮",
    "guaci": "謙：亨，君子有終。",
    "yao": [
      {
        "label": "初六",
        "text": "謙謙君子，用涉大川，吉。"
      },
      {
        "label": "六二",
        "text": "鳴謙，貞吉。"
      },
      {
        "label": "九三",
        "text": "勞謙君子，有終吉。"
      },
      {
        "label": "六四",
        "text": "无不利，撝謙。"
      },
      {
        "label": "六五",
        "text": "不富，以其鄰，利用侵伐，无不利。"
      },
      {
        "label": "上六",
        "text": "鳴謙，利用行師，征邑國。"
      }
    ],
    "yong": null
  },
  {
    "n": 16,
    "name": "豫",
    "upper_trigram": "震",
    "lower_trigram": "坤",
    "guaci": "豫：利建侯行師。",
    "yao": [
      {
        "label": "初六",
        "text": "鳴豫，凶。"
      },
      {
        "label": "六二",
        "text": "介于石，不終日，貞吉。"
      },
      {
        "label": "六三",
        "text": "盱豫，悔。遲有悔。"
      },
      {
        "label": "九四",
        "text": "由豫，大有得。勿疑。朋盍戠。"
      },
      {
        "label": "六五",
        "text": "貞疾，恆不死。"
      },
      {
        "label": "上六",
        "text": "冥豫，成有渝，无咎。"
      }
    ],
    "yong": null
  },
  {
    "n": 17,
    "name": "隨",
    "upper_trigram": "兌",
    "lower_trigram": "震",
    "guaci": "隨：元亨。利貞。无咎。",
    "yao": [
      {
        "label": "初九",
        "text": "官有渝，貞吉。出門交有功。"
      },
      {
        "label": "六二",
        "text": "係小子，失丈夫。"
      },
      {
        "label": "六三",
        "text": "係丈夫，失小子。隨，有求得利，居貞。"
      },
      {
        "label": "九四",
        "text": "隨有獲，貞凶。有孚在道，以明，何咎。"
      },
      {
        "label": "九五",
        "text": "孚于嘉，吉。"
      },
      {
        "label": "上六",
        "text": "拘係之，乃從維之。王用亨于西山。"
      }
    ],
    "yong": null
  },
  {
    "n": 18,
    "name": "蠱",
    "upper_trigram": "艮",
    "lower_trigram": "巽",
    "guaci": "蠱：元亨。利涉大川。先甲三日，後甲三日。",
    "yao": [
      {
        "label": "初六",
        "text": "幹父之蠱，有子考，无咎，厲終吉。"
      },
      {
        "label": "九二",
        "text": "幹母之蠱，不可貞。"
      },
      {
        "label": "九三",
        "text": "幹父之蠱，小有悔，无大咎。"
      },
      {
        "label": "六四",
        "text": "裕父之蠱，往見吝。"
      },
      {
        "label": "六五",
        "text": "幹父之蠱，用譽。"
      },
      {
        "label": "上九",
        "text": "不事王侯，高尚其事。"
      }
    ],
    "yong": null
  },
  {
    "n": 19,
    "name": "臨",
    "upper_trigram": "坤",
    "lower_trigram": "兌",
    "guaci": "臨：元亨。利貞。至于八月有凶。",
    "yao": [
      {
        "label": "初九",
        "text": "咸臨，貞吉。"
      },
      {
        "label": "九二",
        "text": "咸臨，吉无不利。"
      },
      {
        "label": "六三",
        "text": "甘臨，无攸利。既憂之，无咎。"
      },
      {
        "label": "六四",
        "text": "至臨，无咎。"
      },
      {
        "label": "六五",
        "text": "知臨，大君之宜，吉。"
      },
      {
        "label": "上六",
        "text": "敦臨，吉无咎。"
      }
    ],
    "yong": null
  },
  {
    "n": 20,
    "name": "觀",
    "upper_trigram": "巽",
    "lower_trigram": "坤",
    "guaci": "觀：盥而不薦，有孚顒若。",
    "yao": [
      {
        "label": "初六",
        "text": "童觀，小人无咎，君子吝。"
      },
      {
        "label": "六二",
        "text": "窺觀，利女貞。"
      },
      {
        "label": "六三",
        "text": "觀我生，進退。"
      },
      {
        "label": "六四",
        "text": "觀國之光，利用賓于王。"
      },
      {
        "label": "九五",
        "text": "觀我生，君子无咎。"
      },
      {
        "label": "上九",
        "text": "觀其生，君子无咎。"
      }
    ],
    "yong": null
  },
  {
    "n": 21,
    "name": "噬嗑",
    "upper_trigram": "離",
    "lower_trigram": "震",
    "guaci": "噬嗑：亨。利用獄。",
    "yao": [
      {
        "label": "初九",
        "text": "屨校滅趾，无咎。"
      },
      {
        "label": "六二",
        "text": "噬膚滅鼻，无咎。"
      },
      {
        "label": "六三",
        "text": "噬昔肉，遇毒；小吝，无咎。"
      },
      {
        "label": "九四",
        "text": "噬乾胏，得金矢，利艱貞，吉。"
      },
      {
        "label": "六五",
        "text": "噬乾肉，得黃金，貞厲，无咎。"
      },
      {
        "label": "上九",
        "text": "何校滅耳，凶。"
      }
    ],
    "yong": null
  },
  {
    "n": 22,
    "name": "賁",
    "upper_trigram": "艮",
    "lower_trigram": "離",
    "guaci": "賁：亨。小利有攸往。",
    "yao": [
      {
        "label": "初九",
        "text": "賁其趾，舍車而徒。"
      },
      {
        "label": "六二",
        "text": "賁其須。"
      },
      {
        "label": "九三",
        "text": "賁如濡如，永貞吉。"
      },
      {
        "label": "六四",
        "text": "賁如皤如，白馬翰如，匪寇婚媾。"
      },
      {
        "label": "六五",
        "text": "賁於丘園，束帛戔戔，吝，終吉。"
      },
      {
        "label": "上九",
        "text": "白賁，无咎。"
      }
    ],
    "yong": null
  },
  {
    "n": 23,
    "name": "剝",
    "upper_trigram": "艮",
    "lower_trigram": "坤",
    "guaci": "剝：不利。有攸往。",
    "yao": [
      {
        "label": "初六",
        "text": "剝牀以足，蔑貞凶。"
      },
      {
        "label": "六二",
        "text": "剝牀以辨，蔑貞凶。"
      },
      {
        "label": "六三",
        "text": "剝之，无咎。"
      },
      {
        "label": "六四",
        "text": "剝牀以膚，凶。"
      },
      {
        "label": "六五",
        "text": "貫魚，以宮人寵，无不利。"
      },
      {
        "label": "上九",
        "text": "碩果不食，君子德車，小人剝廬。"
      }
    ],
    "yong": null
  },
  {
    "n": 24,
    "name": "復",
    "upper_trigram": "坤",
    "lower_trigram": "震",
    "guaci": "復：亨。出入无疾，朋來无咎。反復其道，七日來復，利有攸往。",
    "yao": [
      {
        "label": "初九",
        "text": "不遠復，无祇悔，元吉。"
      },
      {
        "label": "六二",
        "text": "休復，吉。"
      },
      {
        "label": "六三",
        "text": "頻復，厲无咎。"
      },
      {
        "label": "六四",
        "text": "中行獨復。"
      },
      {
        "label": "六五",
        "text": "敦復，无悔。"
      },
      {
        "label": "上六",
        "text": "迷復，凶，有災眚。用行師，終有大敗，以其國君，凶；至于十年，不克征。"
      }
    ],
    "yong": null
  },
  {
    "n": 25,
    "name": "无妄",
    "upper_trigram": "乾",
    "lower_trigram": "震",
    "guaci": "无妄：元亨。利貞。其匪正有眚，不利有攸往。",
    "yao": [
      {
        "label": "初九",
        "text": "无妄，往吉。"
      },
      {
        "label": "六二",
        "text": "不耕穫，不菑畬，則利有攸往。"
      },
      {
        "label": "六三",
        "text": "无妄之災，或繫之牛，行人之得，邑人之災。"
      },
      {
        "label": "九四",
        "text": "可貞，无咎。"
      },
      {
        "label": "九五",
        "text": "无妄之疾，勿藥有喜。"
      },
      {
        "label": "上九",
        "text": "无妄，行有眚，无攸利。"
      }
    ],
    "yong": null
  },
  {
    "n": 26,
    "name": "大畜",
    "upper_trigram": "艮",
    "lower_trigram": "乾",
    "guaci": "大畜：利貞，不家食吉，利涉大川。",
    "yao": [
      {
        "label": "初九",
        "text": "有厲利已。"
      },
      {
        "label": "九二",
        "text": "輿說輹。"
      },
      {
        "label": "九三",
        "text": "良馬逐，利艱貞，吉。日閑輿衛，利有攸往。"
      },
      {
        "label": "六四",
        "text": "童牛之告，元吉。"
      },
      {
        "label": "六五",
        "text": "豶豕之牙，吉。"
      },
      {
        "label": "上九",
        "text": "何天之衢，亨。"
      }
    ],
    "yong": null
  },
  {
    "n": 27,
    "name": "頤",
    "upper_trigram": "艮",
    "lower_trigram": "震",
    "guaci": "頤：貞吉。觀頤，自求口實。",
    "yao": [
      {
        "label": "初九",
        "text": "舍爾靈龜，觀我朵頤，凶。"
      },
      {
        "label": "六二",
        "text": "顛頤，拂經，于丘頤，征凶。"
      },
      {
        "label": "六三",
        "text": "拂頤，貞凶，十年勿用，无攸利。"
      },
      {
        "label": "六四",
        "text": "顛頤吉，虎視眈眈，其欲逐逐，无咎。"
      },
      {
        "label": "六五",
        "text": "拂經，居貞吉，不可涉大川。"
      },
      {
        "label": "上九",
        "text": "由頤，厲吉，利涉大川。"
      }
    ],
    "yong": null
  },
  {
    "n": 28,
    "name": "大過",
    "upper_trigram": "兌",
    "lower_trigram": "巽",
    "guaci": "大過：棟橈，利有攸往，亨。",
    "yao": [
      {
        "label": "初六",
        "text": "藉用白茅，无咎。"
      },
      {
        "label": "九二",
        "text": "枯楊生稊，老夫得其女妻，无不利。"
      },
      {
        "label": "九三",
        "text": "棟橈，凶。"
      },
      {
        "label": "九四",
        "text": "棟隆，吉。有它吝。"
      },
      {
        "label": "九五",
        "text": "枯楊生華，老婦得其士夫，无咎无譽。"
      },
      {
        "label": "上六",
        "text": "過涉滅頂，凶，无咎。"
      }
    ],
    "yong": null
  },
  {
    "n": 29,
    "name": "坎",
    "upper_trigram": "坎",
    "lower_trigram": "坎",
    "guaci": "習坎：有孚，維心亨。行有尚。",
    "yao": [
      {
        "label": "初六",
        "text": "習坎，入于坎窞，凶。"
      },
      {
        "label": "九二",
        "text": "坎有險，求小得。"
      },
      {
        "label": "六三",
        "text": "來之坎坎，險且枕，入于坎窞，勿用。"
      },
      {
        "label": "六四",
        "text": "尊酒簋，貳用缶。内約自牖，終无咎。"
      },
      {
        "label": "九五",
        "text": "坎不盈，禔既平，无咎。"
      },
      {
        "label": "上六",
        "text": "係用徽纆，寘于叢棘，三歲不得，凶。"
      }
    ],
    "yong": null
  },
  {
    "n": 30,
    "name": "離",
    "upper_trigram": "離",
    "lower_trigram": "離",
    "guaci": "離：利貞。亨。畜牝牛，吉。",
    "yao": [
      {
        "label": "初九",
        "text": "履錯然，敬之无咎。"
      },
      {
        "label": "六二",
        "text": "黃離，元吉。"
      },
      {
        "label": "九三",
        "text": "日昃之離，不鼓缶而歌，則大耋之差，凶。"
      },
      {
        "label": "九四",
        "text": "突如其來如，焚如，死如，棄如。"
      },
      {
        "label": "六五",
        "text": "出涕沱若，戚嗟若，吉。"
      },
      {
        "label": "上九",
        "text": "王用出征，有嘉折首，獲匪其醜，无咎。"
      }
    ],
    "yong": null
  },
  {
    "n": 31,
    "name": "咸",
    "upper_trigram": "兌",
    "lower_trigram": "艮",
    "guaci": "咸：亨。利貞。取女吉。",
    "yao": [
      {
        "label": "初六",
        "text": "咸其拇。"
      },
      {
        "label": "六二",
        "text": "咸其腓，凶，居吉。"
      },
      {
        "label": "九三",
        "text": "咸其股，執其隨，往吝。"
      },
      {
        "label": "九四",
        "text": "貞吉悔亡，憧憧往來，朋從爾思。"
      },
      {
        "label": "九五",
        "text": "咸其脢，无悔。"
      },
      {
        "label": "上六",
        "text": "咸其輔，頰，舌。"
      }
    ],
    "yong": null
  },
  {
    "n": 32,
    "name": "恒",
    "upper_trigram": "震",
    "lower_trigram": "巽",
    "guaci": "恆：亨，无咎。利貞，利有攸往。",
    "yao": [
      {
        "label": "初六",
        "text": "浚恆，貞凶，无攸利。"
      },
      {
        "label": "九二",
        "text": "悔亡。"
      },
      {
        "label": "九三",
        "text": "不恆其德，或承之羞，貞吝。"
      },
      {
        "label": "九四",
        "text": "田无禽。"
      },
      {
        "label": "六五",
        "text": "恆其德，貞，婦人吉，夫子凶。"
      },
      {
        "label": "上六",
        "text": "震恆，凶。"
      }
    ],
    "yong": null
  },
  {
    "n": 33,
    "name": "遯",
    "upper_trigram": "乾",
    "lower_trigram": "艮",
    "guaci": "遯：亨。小利貞。",
    "yao": [
      {
        "label": "初六",
        "text": "遯尾，厲，勿用有攸往。"
      },
      {
        "label": "六二",
        "text": "執之用黃牛之革，莫之勝說。"
      },
      {
        "label": "九三",
        "text": "係遯，有疾厲，畜臣妾吉。"
      },
      {
        "label": "九四",
        "text": "好遯君子吉，小人否。"
      },
      {
        "label": "九五",
        "text": "嘉遯，貞吉。"
      },
      {
        "label": "上九",
        "text": "肥遯，无不利。"
      }
    ],
    "yong": null
  },
  {
    "n": 34,
    "name": "大壯",
    "upper_trigram": "震",
    "lower_trigram": "乾",
    "guaci": "大壯：利貞。",
    "yao": [
      {
        "label": "初九",
        "text": "壯于趾，征凶，有孚。"
      },
      {
        "label": "九二",
        "text": "貞吉。"
      },
      {
        "label": "九三",
        "text": "小人用壯，君子用罔，貞厲。羝羊觸藩，羸其角。"
      },
      {
        "label": "九四",
        "text": "貞吉悔亡，藩決不羸，壯于大轝之腹。"
      },
      {
        "label": "六五",
        "text": "喪羊于易，无悔。"
      },
      {
        "label": "上六",
        "text": "羝羊觸藩，不能退，不能遂，无攸利，艱則吉。"
      }
    ],
    "yong": null
  },
  {
    "n": 35,
    "name": "晉",
    "upper_trigram": "離",
    "lower_trigram": "坤",
    "guaci": "晉：康侯用錫馬蕃庶，晝日三接。",
    "yao": [
      {
        "label": "初六",
        "text": "晉如，摧如，貞吉。罔孚，裕无咎。"
      },
      {
        "label": "六二",
        "text": "晉如，愁如，貞吉。受茲介福，于其王母。"
      },
      {
        "label": "六三",
        "text": "眾允，悔亡。"
      },
      {
        "label": "九四",
        "text": "晉如鼫鼠，貞厲。"
      },
      {
        "label": "六五",
        "text": "悔亡，矢得勿恤，往吉无不利。"
      },
      {
        "label": "上九",
        "text": "晉其角，維用伐邑，厲吉无咎，貞吝。"
      }
    ],
    "yong": null
  },
  {
    "n": 36,
    "name": "明夷",
    "upper_trigram": "坤",
    "lower_trigram": "離",
    "guaci": "明夷：利艱貞。",
    "yao": [
      {
        "label": "初九",
        "text": "明夷于飛，垂其翼。君子于行，三日不食，有攸往，主人有言。"
      },
      {
        "label": "六二",
        "text": "明夷，夷于左股，用拯馬壯，吉。"
      },
      {
        "label": "九三",
        "text": "明夷于南狩，得其大首，不可疾貞。"
      },
      {
        "label": "六四",
        "text": "入于左腹，獲明夷之心，于出門庭。"
      },
      {
        "label": "六五",
        "text": "箕子之明夷，利貞。"
      },
      {
        "label": "上六",
        "text": "不明晦，初登于天，後入于地。"
      }
    ],
    "yong": null
  },
  {
    "n": 37,
    "name": "家人",
    "upper_trigram": "巽",
    "lower_trigram": "離",
    "guaci": "家人：利女貞。",
    "yao": [
      {
        "label": "初九",
        "text": "閑有家，悔亡。"
      },
      {
        "label": "六二",
        "text": "无攸遂，在中饋，貞吉。"
      },
      {
        "label": "九三",
        "text": "家人嗃嗃，悔厲吉；婦子嘻嘻，終吝。"
      },
      {
        "label": "六四",
        "text": "富家，大吉。"
      },
      {
        "label": "九五",
        "text": "王假有家，勿恤。吉。"
      },
      {
        "label": "上九",
        "text": "有孚威如，終吉。"
      }
    ],
    "yong": null
  },
  {
    "n": 38,
    "name": "睽",
    "upper_trigram": "離",
    "lower_trigram": "兌",
    "guaci": "睽：小事吉。",
    "yao": [
      {
        "label": "初九",
        "text": "悔亡，喪馬勿逐，自復；見惡人无咎。"
      },
      {
        "label": "九二",
        "text": "遇主于巷，无咎。"
      },
      {
        "label": "六三",
        "text": "見輿曳，其牛𧤊，其人天且劓，无初有終。"
      },
      {
        "label": "九四",
        "text": "睽孤，遇元夫，交孚，厲无咎。"
      },
      {
        "label": "六五",
        "text": "悔亡，厥宗噬膚，往何咎。"
      },
      {
        "label": "上九",
        "text": "睽孤，見豕負涂，載鬼一車，先張之弧，後說之弧，匪寇婚媾，往遇雨則吉。"
      }
    ],
    "yong": null
  },
  {
    "n": 39,
    "name": "蹇",
    "upper_trigram": "坎",
    "lower_trigram": "艮",
    "guaci": "蹇：利西南，不利東北；利見大人，貞吉。",
    "yao": [
      {
        "label": "初六",
        "text": "往蹇，來譽。"
      },
      {
        "label": "六二",
        "text": "王臣蹇蹇，匪躬之故。"
      },
      {
        "label": "九三",
        "text": "往蹇來反。"
      },
      {
        "label": "六四",
        "text": "往蹇來連。"
      },
      {
        "label": "九五",
        "text": "大蹇朋來。"
      },
      {
        "label": "上六",
        "text": "往蹇來碩，吉；利見大人。"
      }
    ],
    "yong": null
  },
  {
    "n": 40,
    "name": "解",
    "upper_trigram": "震",
    "lower_trigram": "坎",
    "guaci": "解：利西南，无所往，其來復吉。有攸往，夙吉。",
    "yao": [
      {
        "label": "初六",
        "text": "无咎。"
      },
      {
        "label": "九二",
        "text": "田獲三狐，得黃矢，貞吉。"
      },
      {
        "label": "六三",
        "text": "負且乘，致寇至，貞吝。"
      },
      {
        "label": "九四",
        "text": "解而拇，朋至斯孚。"
      },
      {
        "label": "六五",
        "text": "君子惟有解，吉；有孚于小人。"
      },
      {
        "label": "上六",
        "text": "公用射隼，于高墉之上，獲之，无不利。"
      }
    ],
    "yong": null
  },
  {
    "n": 41,
    "name": "損",
    "upper_trigram": "艮",
    "lower_trigram": "兌",
    "guaci": "損：有孚，元吉。无咎，可貞，利有攸往。曷之用？二簋可用享。",
    "yao": [
      {
        "label": "初九",
        "text": "祀事遄往，无咎，酌損之。"
      },
      {
        "label": "九二",
        "text": "利貞，征凶，弗損益之。"
      },
      {
        "label": "六三",
        "text": "三人行，則損一人；一人行，則得其友。"
      },
      {
        "label": "六四",
        "text": "損其疾，使遄有喜，无咎。"
      },
      {
        "label": "六五",
        "text": "或益之，十朋之龜弗克違，元吉。"
      },
      {
        "label": "上九",
        "text": "弗損益之，无咎，貞吉，利有攸往，得臣无家。"
      }
    ],
    "yong": null
  },
  {
    "n": 42,
    "name": "益",
    "upper_trigram": "巽",
    "lower_trigram": "震",
    "guaci": "益：利有攸往。利涉大川。",
    "yao": [
      {
        "label": "初九",
        "text": "利用為大作，元吉，无咎。"
      },
      {
        "label": "六二",
        "text": "或益之，十朋之龜弗克違，永貞吉。王用享于帝，吉。"
      },
      {
        "label": "六三",
        "text": "益之用凶事，无咎。有孚中行，告公用圭。"
      },
      {
        "label": "六四",
        "text": "中行，告公從。利用為依遷國。"
      },
      {
        "label": "九五",
        "text": "有孚惠心，勿問元吉。有孚惠我德。"
      },
      {
        "label": "上九",
        "text": "莫益之，或擊之，立心勿恆，凶。"
      }
    ],
    "yong": null
  },
  {
    "n": 43,
    "name": "夬",
    "upper_trigram": "兌",
    "lower_trigram": "乾",
    "guaci": "夬：揚于王庭，孚號，有厲，告自邑，不利即戎，利有攸往。",
    "yao": [
      {
        "label": "初九",
        "text": "壯于前趾，往不勝為咎。"
      },
      {
        "label": "九二",
        "text": "惕號，莫夜有戎，勿恤。"
      },
      {
        "label": "九三",
        "text": "壯于頄，有凶。君子夬夬，獨行遇雨，若濡有慍，无咎。"
      },
      {
        "label": "九四",
        "text": "臀无膚，其行次且。牽羊悔亡，聞言不信。"
      },
      {
        "label": "九五",
        "text": "莧陸夬夬，中行无咎。"
      },
      {
        "label": "上六",
        "text": "无號，終有凶。"
      }
    ],
    "yong": null
  },
  {
    "n": 44,
    "name": "姤",
    "upper_trigram": "乾",
    "lower_trigram": "巽",
    "guaci": "姤：女壯，勿用取女。",
    "yao": [
      {
        "label": "初六",
        "text": "系于金柅，貞吉，有攸往，見凶，羸豕，孚，蹢躅。"
      },
      {
        "label": "九二",
        "text": "包有魚，无咎，不利賓。"
      },
      {
        "label": "九三",
        "text": "臀无膚，其行次且，厲，无大咎。"
      },
      {
        "label": "九四",
        "text": "包无魚，起凶。"
      },
      {
        "label": "九五",
        "text": "以杞包瓜，含章，有隕自天。"
      },
      {
        "label": "上九",
        "text": "姤其角，吝，无咎。"
      }
    ],
    "yong": null
  },
  {
    "n": 45,
    "name": "萃",
    "upper_trigram": "兌",
    "lower_trigram": "坤",
    "guaci": "萃：王假有廟，利見大人，亨。利貞。用大牲吉，利有攸往。",
    "yao": [
      {
        "label": "初六",
        "text": "有孚不終，乃亂乃萃，若號一握為笑，勿恤，往无咎。"
      },
      {
        "label": "六二",
        "text": "引吉，无咎，孚乃利用禴。"
      },
      {
        "label": "六三",
        "text": "萃如，嗟如，无攸利，往无咎，小吝。"
      },
      {
        "label": "九四",
        "text": "大吉，无咎。"
      },
      {
        "label": "九五",
        "text": "萃有位，无咎。匪孚，元永貞，悔亡。"
      },
      {
        "label": "上六",
        "text": "齎資涕洟，无咎。"
      }
    ],
    "yong": null
  },
  {
    "n": 46,
    "name": "升",
    "upper_trigram": "坤",
    "lower_trigram": "巽",
    "guaci": "升：元亨，用見大人，勿恤，南征吉。",
    "yao": [
      {
        "label": "初六",
        "text": "允升，大吉。"
      },
      {
        "label": "九二",
        "text": "孚乃利用禴，无咎。"
      },
      {
        "label": "九三",
        "text": "升虛邑。"
      },
      {
        "label": "六四",
        "text": "王用享于岐山，吉无咎。"
      },
      {
        "label": "六五",
        "text": "貞吉，升階。"
      },
      {
        "label": "上六",
        "text": "冥升，利于不息之貞。"
      }
    ],
    "yong": null
  },
  {
    "n": 47,
    "name": "困",
    "upper_trigram": "兌",
    "lower_trigram": "坎",
    "guaci": "困：亨，貞大人吉，无咎，有言不信。",
    "yao": [
      {
        "label": "初六",
        "text": "臀困于株木，入于幽谷，三歲不覿。"
      },
      {
        "label": "九二",
        "text": "困于酒食，朱紱方來，利用亨祀，征凶，无咎。"
      },
      {
        "label": "六三",
        "text": "困于石，據于蒺蔾，入于其宮，不見其妻，凶。"
      },
      {
        "label": "九四",
        "text": "來荼荼，困于金轝，吝，有終。"
      },
      {
        "label": "九五",
        "text": "劓刖，困于赤紱，乃徐有說，利用祭祀。"
      },
      {
        "label": "上六",
        "text": "困于葛藟，于臲卼，曰動悔。有悔，征吉。"
      }
    ],
    "yong": null
  },
  {
    "n": 48,
    "name": "井",
    "upper_trigram": "坎",
    "lower_trigram": "巽",
    "guaci": "井：改邑不改井，无喪无得，往來井井。汔至亦未繘井。羸其瓶，凶。",
    "yao": [
      {
        "label": "初六",
        "text": "井泥不食，舊井无禽。"
      },
      {
        "label": "九二",
        "text": "井谷射鮒，瓮敝漏。"
      },
      {
        "label": "九三",
        "text": "井渫不食，為我心惻，可用汲，王明，並受其福。"
      },
      {
        "label": "六四",
        "text": "井甃，无咎。"
      },
      {
        "label": "九五",
        "text": "井冽，寒泉食。"
      },
      {
        "label": "上六",
        "text": "井收勿幕，有孚元吉。"
      }
    ],
    "yong": null
  },
  {
    "n": 49,
    "name": "革",
    "upper_trigram": "兌",
    "lower_trigram": "離",
    "guaci": "革：已日乃孚，元亨。利貞。悔亡。",
    "yao": [
      {
        "label": "初九",
        "text": "鞏用黃牛之革。"
      },
      {
        "label": "六二",
        "text": "已日乃革之，征吉，无咎。"
      },
      {
        "label": "九三",
        "text": "征凶，貞厲，革言三就，有孚。"
      },
      {
        "label": "九四",
        "text": "悔亡，有孚改命，吉。"
      },
      {
        "label": "九五",
        "text": "大人虎變，未占有孚。"
      },
      {
        "label": "上六",
        "text": "君子豹變，小人革面，征凶，居貞吉。"
      }
    ],
    "yong": null
  },
  {
    "n": 50,
    "name": "鼎",
    "upper_trigram": "離",
    "lower_trigram": "巽",
    "guaci": "鼎：元吉，亨。",
    "yao": [
      {
        "label": "初六",
        "text": "鼎顛趾，利出否，得妾以其子，无咎。"
      },
      {
        "label": "九二",
        "text": "鼎有實，我仇有疾，不我能即，吉。"
      },
      {
        "label": "九三",
        "text": "鼎耳革，其行塞，雉膏不食，方雨虧悔，終吉。"
      },
      {
        "label": "九四",
        "text": "鼎折足，覆公餗，其刑渥，凶。"
      },
      {
        "label": "六五",
        "text": "鼎黃耳金鉉，利貞。"
      },
      {
        "label": "上九",
        "text": "鼎玉鉉，大吉，无不利。"
      }
    ],
    "yong": null
  },
  {
    "n": 51,
    "name": "震",
    "upper_trigram": "震",
    "lower_trigram": "震",
    "guaci": "震：亨。震來虩虩，笑言啞啞。震驚百里，不喪匕鬯。",
    "yao": [
      {
        "label": "初九",
        "text": "震來虩虩，後笑言啞啞，吉。"
      },
      {
        "label": "六二",
        "text": "震來厲，億喪貝，躋于九陵，勿逐，七日得。"
      },
      {
        "label": "六三",
        "text": "震蘇蘇，震行无眚。"
      },
      {
        "label": "九四",
        "text": "震遂泥。"
      },
      {
        "label": "六五",
        "text": "震往來厲，億无喪，有事。"
      },
      {
        "label": "上六",
        "text": "震索索，視矍矍，征凶。震不于其躬，于其鄰，无咎。婚媾有言。"
      }
    ],
    "yong": null
  },
  {
    "n": 52,
    "name": "艮",
    "upper_trigram": "艮",
    "lower_trigram": "艮",
    "guaci": "艮：艮其背，不獲其身，行其庭，不見其人，无咎。",
    "yao": [
      {
        "label": "初六",
        "text": "艮其趾，无咎，利永貞。"
      },
      {
        "label": "六二",
        "text": "艮其腓，不拯其隨，其心不快。"
      },
      {
        "label": "九三",
        "text": "艮其限，裂其夤，厲閽心。"
      },
      {
        "label": "六四",
        "text": "艮其身，无咎。"
      },
      {
        "label": "六五",
        "text": "艮其輔，言有孚，悔亡。"
      },
      {
        "label": "上九",
        "text": "敦艮，吉。"
      }
    ],
    "yong": null
  },
  {
    "n": 53,
    "name": "漸",
    "upper_trigram": "巽",
    "lower_trigram": "艮",
    "guaci": "漸：女歸吉，利貞。",
    "yao": [
      {
        "label": "初六",
        "text": "鴻漸于干，小子厲，有言，无咎。"
      },
      {
        "label": "六二",
        "text": "鴻漸于磐，飲食衎衎，吉。"
      },
      {
        "label": "九三",
        "text": "鴻漸于陸，夫征不復，婦孕不育，凶；利禦寇。"
      },
      {
        "label": "六四",
        "text": "鴻漸于木，或得其桷，无咎。"
      },
      {
        "label": "九五",
        "text": "鴻漸于陵，婦三歲不孕，終莫之勝，吉。"
      },
      {
        "label": "上九",
        "text": "鴻漸于陸，其羽可用為儀，吉。"
      }
    ],
    "yong": null
  },
  {
